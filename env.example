# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: Custom from email (must be a verified domain in Resend)
# For development/testing, you can use: F&D Staging <onboarding@resend.dev>
# For production, use your verified domain: F&D Staging <info@fanddstaging.com>
RESEND_FROM_EMAIL=F&D Staging <onboarding@resend.dev>

# Optional: Recipient email for contact form submissions
# Default: info@fanddstaging.com
CONTACT_EMAIL=info@fanddstaging.com
